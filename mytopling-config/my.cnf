# MyTopling server options.
#
# mytoplingd-conf.sh reads datadir here to generate the sideplugin config, and
# mytoplingd.sh passes this file to mysqld with --defaults-file, which keeps the
# machine's own my.cnf (possibly another MySQL's) out of this server. The caller
# can override that with --defaults-file/--defaults-extra-file/--no-defaults.
# Use MYTOPLING_CNF to point both at another file.

[mysqld]
datadir=/var/lib/mytopling
#port=3306
#socket=/var/lib/mytopling/mysql.sock
