# MyTopling server options.
#
# mytoplingd-conf.sh reads datadir here to generate the sideplugin config, and
# mytoplingd.sh passes this file to mysqld with --defaults-file, so the machine's
# own my.cnf (which may belong to another MySQL) does not leak into this server.
# Use MYTOPLING_CNF to point both at another file.

[mysqld]
datadir=/var/lib/mytopling
#port=3306
#socket=/var/lib/mytopling/mysql.sock
